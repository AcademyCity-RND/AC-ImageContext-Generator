# ==============================================================================
# IMAGE-CONTEXT GENERATOR (.env)
# ==============================================================================
# Masukkan Google Gemini API Key Anda di bawah ini:
# Link gratis (Free Tier): https://aistudio.google.com/app/apikey
# ==============================================================================
GOOGLE_API_KEY=MASUKKAN_GEMINI_API_KEY_DI_SINI

# [OPSIONAL] OpenAI API Key jika menggunakan fallback provider
OPENAI_API_KEY=MASUKKAN_OPENAI_API_KEY_DI_SINI_JIKA_ADA

# Level Log (INFO / DEBUG / WARNING)
LOG_LEVEL=INFO
